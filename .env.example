# CareerPilot OS configuration. Copy to .env and fill in. Never commit .env.
# Generate random secrets with e.g.:  openssl rand -base64 48

# ---- Core secrets (required) -------------------------------------------------------------
JWT_SECRET_KEY=                 # >= 32 random bytes
AI_SERVICE_TOKEN=               # shared backend <-> AI service token (random string)
DB_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=careerpilot
S3_SECRET_KEY=                  # >= 8 characters (MinIO)
GRAFANA_ADMIN_PASSWORD=

# ---- Public URL ---------------------------------------------------------------------------
PUBLIC_URL=http://localhost
HTTP_PORT=80

# ---- AI provider (choose one) ----------------------------------------------------------------
# ollama (local, free) | openai | anthropic | gemini
LLM_PROVIDER=ollama
LLM_MODEL=                      # default per provider: llama3.2 | gpt-4o-mini | claude-opus-5-5 | gemini-2.5-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=600

# Embeddings: ollama | openai | gemini | sentence-transformers
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=                # default: nomic-embed-text (ollama), text-embedding-3-small (openai)

# ---- Optional integrations ------------------------------------------------------------------
N8N_INGESTION_SHARED_SECRET=    # enables POST /api/v1/communications/ingest/n8n when set
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Email sending (M22.7). Key: 32 random bytes, base64 (openssl rand -base64 32)
EMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost/api/v1/email/oauth/gmail/callback
OUTLOOK_OAUTH_CLIENT_ID=
OUTLOOK_OAUTH_CLIENT_SECRET=
OUTLOOK_OAUTH_REDIRECT_URI=http://localhost/api/v1/email/oauth/outlook/callback
